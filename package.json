{
  "name": "jsqr",
  "version": "1.4.0",
  "description": "A pure javascript QR code reading library that takes in raw images and will locate, extract and parse any QR code found within.",
  "repository": "https://github.com/cozmo/jsQR",
  "bugs": "https://github.com/cozmo/jsQR/issues",
  "homepage": "https://github.com/cozmo/jsQR#readme",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/jsQR.js",
  "jsdelivr": "./dist/jsQR.js",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    {
      "name": "Cosmo Wolfe",
      "email": "cosmo.wolfe@gmail.com"
    },
    {
      "name": "Jefff Nelson",
      "email": "gmjefff@gmail.com"
    }
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/locator/locator.test.ts src/extractor/extractor.test.ts src/decoder/decoder.test.ts tests/end-to-end.test.ts",
    "generate-test-data": "tsx tests/generate-test-data.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "upng-js": "^1.0.1"
  }
}
